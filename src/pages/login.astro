---
import Base from "../layouts/Base.astro";
import AuthShell from "../components/AuthShell.astro";
import { icons } from "../lib/icons";
---

<Base title="Log in" description="Log in to your Uber account.">
  <AuthShell title="What's your phone number or email?">
    <form id="auth-form">
      <div class="auth-field">
        <div class="field">
          <input id="identifier" type="text" placeholder="Enter phone number or email" required />
        </div>
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit">Continue</button>
    </form>

    <div class="auth-divider">or</div>

    <button class="social-btn"><span class="ic" set:html={icons.google} />Continue with Google</button>
    <button class="social-btn"><span class="ic" set:html={icons.apple} />Continue with Apple</button>

    <p class="auth-fine">
      By proceeding, you consent to get calls, WhatsApp or SMS/RCS messages,
      including by automated means, from Uber and its affiliates to the number
      provided.
    </p>

    <p class="auth-switch">
      New to Uber? <a href="/signup">Create an account</a>
    </p>
  </AuthShell>
</Base>

<script>
  document.getElementById("auth-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    window.location.href = "/ride";
  });
</script>
