---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { icons } from "../lib/icons";
---

<Base title="Request a ride" fullscreen>
  <div class="app">
    <!-- Map -->
    <div class="map" id="map" aria-label="Live map"></div>

    <!-- floating top bar (mobile / over map) -->
    <div class="topbar">
      <a class="round-btn" href="/" aria-label="Back to home">
        <span class="ic" set:html={icons.chevronLeft} />
      </a>
      <div class="topbar-logo"><Logo size={24} href="/" /></div>
      <a class="round-btn" href="/login/" aria-label="Account">
        <span class="ic" set:html={icons.user} />
      </a>
    </div>

    <!-- Panel / bottom sheet -->
    <aside class="panel" id="panel">
      <div class="panel-head">
        <Logo size={26} href="/" />
        <a class="round-btn sm" href="/login/" aria-label="Account">
          <span class="ic" set:html={icons.user} />
        </a>
      </div>
      <div class="sheet-grip" aria-hidden="true"></div>
      <div class="sheet" id="sheet"><!-- rendered by ride.ts --></div>
    </aside>
  </div>
</Base>

<style>
  .app {
    height: 100dvh;
    width: 100%;
    display: grid;
    grid-template-columns: 420px 1fr;
    position: relative;
  }
  .map {
    grid-column: 2;
    background: var(--map-bg);
    position: relative;
    overflow: hidden;
  }

  .panel {
    grid-column: 1;
    background: var(--white);
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 16px rgba(0, 0, 0, 0.08);
    z-index: 20;
    overflow: hidden;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px 8px;
  }
  .sheet-grip {
    display: none;
  }
  .sheet {
    padding: 8px 22px 24px;
    overflow-y: auto;
    flex: 1;
  }

  .round-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow);
    color: var(--black);
    border: none;
  }
  .round-btn.sm {
    width: 38px;
    height: 38px;
    box-shadow: none;
    background: var(--mono-200);
  }
  .round-btn:hover {
    background: var(--mono-200);
  }
  .round-btn .ic {
    width: 22px;
    height: 22px;
    display: inline-flex;
  }

  .topbar {
    display: none;
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 30;
    align-items: center;
    justify-content: space-between;
  }
  .topbar-logo {
    background: var(--white);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
  }

  /* mobile → bottom sheet */
  @media (max-width: 820px) {
    .app {
      grid-template-columns: 1fr;
    }
    .map {
      grid-column: 1;
      grid-row: 1;
      height: 100dvh;
    }
    .topbar {
      display: flex;
    }
    .panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: 78dvh;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.18);
    }
    .panel-head {
      display: none;
    }
    .sheet-grip {
      display: block;
      width: 40px;
      height: 5px;
      border-radius: 999px;
      background: var(--mono-400);
      margin: 10px auto 2px;
    }
  }
</style>

<!-- shared style hooks used by JS-rendered step content -->
<style is:global>
  .step h2.step-title {
    font-size: 1.55rem;
    margin-bottom: 16px;
  }

  /* route fields with the connector line */
  .route-fields {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .route-fields::before {
    content: "";
    position: absolute;
    left: 21px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: var(--mono-400);
  }
  .rf {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--mono-200);
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 0 14px;
    height: 50px;
    position: relative;
    z-index: 1;
  }
  .rf:focus-within {
    border-color: var(--black);
    background: var(--white);
  }
  .rf .glyph {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    background: var(--white);
  }
  .rf .glyph.origin {
    border-radius: 50%;
    border: 3px solid #000;
  }
  .rf .glyph.dest {
    border-radius: 2px;
    background: #000;
  }
  .rf input {
    border: none;
    background: transparent;
    outline: none;
    width: 100%;
    font-size: 1rem;
    color: var(--black);
  }
  .rf input::placeholder {
    color: var(--mono-700);
  }

  /* suggestions */
  .suggestions {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
  }
  .sug {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 6px;
    border-radius: var(--radius);
    cursor: pointer;
    text-align: left;
    background: none;
    border: none;
    width: 100%;
  }
  .sug:hover {
    background: var(--mono-200);
  }
  .sug .sug-ic {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--mono-200);
    display: grid;
    place-items: center;
  }
  .sug:hover .sug-ic {
    background: var(--mono-300);
  }
  .sug .sug-ic .ic {
    width: 20px;
    height: 20px;
    display: inline-flex;
  }
  .sug-text strong {
    display: block;
    font-size: 0.98rem;
  }
  .sug-text small {
    color: var(--mono-700);
  }

  /* ride list */
  .trip-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--mono-200);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 16px;
  }
  .trip-summary .ts-line {
    font-size: 0.9rem;
  }
  .trip-summary .ts-line b {
    font-weight: 600;
  }
  .edit-link {
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .ride-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 4px -8px 0;
  }
  .ride-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 12px 10px;
    border-radius: var(--radius);
    border: 2px solid transparent;
    cursor: pointer;
    background: none;
    text-align: left;
    width: 100%;
  }
  .ride-row:hover {
    background: var(--mono-200);
  }
  .ride-row[aria-selected="true"] {
    border-color: var(--black);
    background: var(--white);
  }
  .ride-row .veh {
    width: 60px;
    height: 36px;
    display: inline-flex;
    align-items: center;
  }
  .ride-row .veh svg {
    width: 100%;
  }
  .ride-info .rn {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1.02rem;
  }
  .ride-info .cap {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--mono-700);
    font-weight: 500;
    font-size: 0.85rem;
  }
  .ride-info .cap .ic {
    width: 14px;
    height: 14px;
    display: inline-flex;
  }
  .ride-info .meta {
    color: var(--mono-700);
    font-size: 0.86rem;
  }
  .ride-info .meta .fast {
    color: var(--black);
    font-weight: 600;
  }
  .ride-price {
    text-align: right;
  }
  .ride-price .p {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .ride-price .old {
    display: block;
    color: var(--mono-600);
    text-decoration: line-through;
    font-size: 0.82rem;
  }
  .ride-badge {
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--mono-300);
    border-radius: 4px;
    padding: 2px 6px;
  }

  /* payment + cta */
  .pay-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 6px;
    margin-top: 10px;
    border-top: 1px solid var(--mono-300);
    cursor: pointer;
  }
  .pay-row .pay-left {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .pay-row .ic {
    width: 22px;
    height: 22px;
    display: inline-flex;
  }
  .pay-row .chev {
    width: 18px;
    height: 18px;
    color: var(--mono-700);
  }
  .cta-wrap {
    padding-top: 8px;
  }

  /* driver card */
  .driver-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--mono-300);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 1.3rem;
    flex: 0 0 auto;
  }
  .driver-meta .dn {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .driver-meta .rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--mono-700);
    font-size: 0.9rem;
  }
  .driver-meta .rating .ic {
    width: 14px;
    height: 14px;
    display: inline-flex;
    color: #000;
  }
  .plate {
    margin-left: auto;
    text-align: right;
  }
  .plate .car {
    font-weight: 600;
  }
  .plate .num {
    display: inline-block;
    margin-top: 4px;
    background: var(--black);
    color: var(--white);
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 5px;
    font-size: 0.85rem;
  }
  .contact-row {
    display: flex;
    gap: 12px;
    margin: 14px 0 18px;
  }
  .contact-row .round-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    background: var(--mono-200);
    flex: 1;
    border-radius: var(--radius);
    height: 52px;
    font-weight: 600;
    gap: 8px;
  }
  .contact-row .round-btn .ic {
    width: 20px;
    height: 20px;
  }

  /* status banner */
  .status-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }
  .eta-pill {
    background: var(--black);
    color: var(--white);
    border-radius: var(--radius);
    padding: 12px 14px;
    text-align: center;
    min-width: 78px;
  }
  .eta-pill b {
    display: block;
    font-size: 1.4rem;
    line-height: 1;
  }
  .eta-pill small {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  /* progress bar */
  .progress {
    height: 6px;
    background: var(--mono-300);
    border-radius: 999px;
    overflow: hidden;
    margin: 8px 0 16px;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--black);
    border-radius: 999px;
    transition: width 0.2s linear;
  }

  .info-line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid var(--mono-300);
    color: var(--mono-800);
  }
  .info-line .ic {
    width: 20px;
    height: 20px;
    display: inline-flex;
  }

  /* rating */
  .star-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin: 18px 0;
  }
  .star-row button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--mono-400);
    padding: 4px;
  }
  .star-row button .ic {
    width: 38px;
    height: 38px;
    display: inline-flex;
  }
  .star-row button.on {
    color: #000;
  }
  .fare-final {
    text-align: center;
    margin: 6px 0 4px;
  }
  .fare-final .amt {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
</style>

<script>
  import "../scripts/ride";
</script>
