---
import Base from "../layouts/Base.astro";
import AuthShell from "../components/AuthShell.astro";
import { icons } from "../lib/icons";
---

<Base title="Sign up" description="Create your Uber account.">
  <AuthShell title="Create your account">
    <form id="auth-form">
      <div class="auth-field">
        <label for="name">Full name</label>
        <div class="field"><input id="name" type="text" placeholder="First and last name" required /></div>
      </div>
      <div class="auth-field">
        <label for="identifier">Phone number or email</label>
        <div class="field"><input id="identifier" type="text" placeholder="Enter phone number or email" required /></div>
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit">Continue</button>
    </form>

    <div class="auth-divider">or</div>

    <button class="social-btn"><span class="ic" set:html={icons.google} />Sign up with Google</button>
    <button class="social-btn"><span class="ic" set:html={icons.apple} />Sign up with Apple</button>

    <p class="auth-fine">
      By creating an account, you agree to Uber's <a href="#">Terms of Use</a> and
      acknowledge that you have read our <a href="#">Privacy Notice</a>.
    </p>

    <p class="auth-switch">
      Already have an account? <a href="/login">Log in</a>
    </p>
  </AuthShell>
</Base>

<script>
  document.getElementById("auth-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    window.location.href = "/ride";
  });
</script>
